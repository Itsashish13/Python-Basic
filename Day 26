n = int(input("Enter numbers of elements: "))
arr = []

print("Enter sorted elements: ")
for i in range(n):
    num = int(input())
    arr.append(num)
    
target = int(input("Enter element to search: "))

low = 0
high = n - 1
found = False

while low <= high and target >= arr[low] and target <= arr[high]:
    
    if low == high:
        if arr[low] == target:
            print("Element found at index: ", low)
            found = True
        break
    pos = low + ((target - arr[low]) * (high - low)) // (arr[high] - arr[low])
    
    if arr[pos] == target:
        print("Element found at index: ", pos)
        found = True
        break
    elif arr[pos] < target:
        low = pos + 1
    else:
        high = pos - 1
        
if not found:
    print("Element not found.")
